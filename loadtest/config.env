# Load test configuration. Plain KEY=VALUE lines, no quotes, no secrets.
# Variables already set in the environment win over this file, e.g.
#   STEADY_USERS=50 ./loadtest/run.sh steady
# Use another file with: LOADTEST_CONFIG=path/to/file.env ./loadtest/run.sh steady
# The password is NOT here: it comes from the root .env (SEED_PASSWORD -> LOADTEST_PASSWORD).

# Base URL the load is sent to (inside the compose network by default).
TARGET_HOST=http://api:8000

# Scenario "steady": constant users with think time between requests.
# Number of concurrent users.
STEADY_USERS=100
# Users started per second.
STEADY_SPAWN_RATE=20
# Test length in seconds.
STEADY_DURATION=180

# Scenario "burst": same users but no think time (WAIT_* is ignored).
# Number of concurrent users.
BURST_USERS=100
# Users started per second.
BURST_SPAWN_RATE=100
# Test length in seconds.
BURST_DURATION=120

# Scenario "login_storm": every user only logs in, as fast as possible.
# Number of concurrent users.
LOGIN_STORM_USERS=100
# Users started per second.
LOGIN_STORM_SPAWN_RATE=100
# Test length in seconds.
LOGIN_STORM_DURATION=60

# Scenario "ramp": step through these user counts to find the breaking point.
RAMP_STEPS=50,100,150,200,300
# Seconds spent on each step.
RAMP_STEP_SECONDS=60
# Users started per second when moving to the next step.
RAMP_SPAWN_RATE=20

# Scenario "write_storm": writes only (attendance check 3 : create OT 1), no think time.
# Number of concurrent users.
WRITE_STORM_USERS=100
# Users started per second.
WRITE_STORM_SPAWN_RATE=100
# Test length in seconds.
WRITE_STORM_DURATION=120

# Scenario "write_ramp": writes only, step through these user counts until it breaks.
WRITE_RAMP_STEPS=50,100,200,300,400,600,800
# Seconds spent on each step.
WRITE_RAMP_STEP_SECONDS=60
# Users started per second when moving to the next step.
WRITE_RAMP_SPAWN_RATE=50

# Scenario "custom": set these on the command line, e.g.
#   USERS=250 SPAWN_RATE=25 DURATION=90 ./loadtest/run.sh custom
# Number of concurrent users.
USERS=100
# Users started per second.
SPAWN_RATE=20
# Test length in seconds.
DURATION=60

# Think time between requests, in seconds (random between MIN and MAX).
WAIT_MIN=1
WAIT_MAX=3

# Login code format; "{:04d}" is replaced by the number (Python format syntax).
USER_CODE_FORMAT=E{:04d}
# Inclusive number range of regular employee accounts.
EMPLOYEE_RANGE=14-300
# Inclusive number range of manager accounts.
MANAGER_RANGE=4-13
# Share of simulated users that are managers (percent, rest are employees).
MANAGER_WEIGHT=5
# Time zone used when the test builds dates (zoneinfo name).
LOADTEST_TZ=Asia/Ho_Chi_Minh

# Pass/fail target for the 95th percentile response time, in milliseconds.
TARGET_P95_MS=500
# Pass/fail target for the error rate, in percent.
TARGET_ERR_PCT=1
# A container is flagged as a bottleneck above this percent of its CPU/RAM limit.
BOTTLENECK_PCT=90

# Stop ramp / write_ramp as soon as a step breaks (1 = yes, 0 = run every step).
STOP_ON_BREAK=1
# A step is broken when p95 > TARGET_P95_MS x BREAK_FACTOR ...
BREAK_FACTOR=2
# ... or when its error rate (percent) is above this.
BREAK_ERR_PCT=5
# After a break, keep the load for this many seconds to collect data, then stop.
BREAK_HOLD_SECONDS=30

# Write users (write_storm / write_ramp): retry like a real client on 502/503/504,
# connection errors and timeouts, re-sending the SAME Idempotency-Key.
# Max retries per write.
RETRY_MAX=3
# First backoff in milliseconds (doubles each retry, with jitter).
RETRY_BACKOFF_MS=200
# Longest Retry-After the user will honour, in seconds.
RETRY_AFTER_CAP_S=10
# Request timeout in seconds.
REQUEST_TIMEOUT_S=30

# After a write scenario, re-send once the keys whose final status was an error,
# then re-check the DB (1 = yes, 0 = no).
RECONCILE_RETRY=1

# Compose service that runs Locust.
LOCUST_SERVICE=locust
# Compose profile that enables the Locust service.
COMPOSE_PROFILE=loadtest

# Locust processes forked inside the runner (each one tops out near 1 CPU).
# Keep it <= LOCUST_CPUS from the root .env (default 2).
LOCUST_PROCESSES=2

# App-specific check run after each load test; its output is appended to report.md and a
# non-zero exit fails the run. {since} is replaced by the DB time at the start of the run.
# Leave empty to skip. For another app, point it at that app's own checker.
POST_CHECK_CMD=docker compose exec -T api python -m scripts.check_integrity --since '{since}'
