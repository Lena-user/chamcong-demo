# Copy to .env and adjust. Never commit .env.

# --- PostgreSQL (container "db") ---
POSTGRES_USER=chamcong
POSTGRES_PASSWORD=change-me-db
POSTGRES_DB=chamcong

# SQLAlchemy URL used by api/worker (host "db" is the compose service name)
DATABASE_URL=postgresql+asyncpg://chamcong:change-me-db@db:5432/chamcong
# Database used by pytest (created by scripts/init-db.sql)
TEST_DATABASE_URL=postgresql+asyncpg://chamcong:change-me-db@db:5432/chamcong_test

# --- Redis (job queue + health check) ---
REDIS_URL=redis://redis:6379/0

# --- Auth ---
# HS256 signing key for JWT; use a long random string
JWT_SECRET=change-me-to-a-long-random-string
# JWT lifetime in hours
JWT_EXPIRE_HOURS=12
# Shared password for every seeded account (demo data only)
SEED_PASSWORD=change-me-demo

# --- HTTP ---
# Comma-separated Host headers accepted by TrustedHostMiddleware
ALLOWED_HOSTS=localhost,127.0.0.1,api,*.trycloudflare.com

# --- Business / operational values (all optional, defaults shown) ---
# IANA time zone used to assign attendance events to work dates
TIMEZONE=Asia/Ho_Chi_Minh
# List endpoints: default page size and hard maximum
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100
# Postgres advisory lock key: only one payroll job runs at a time
PAYROLL_LOCK_KEY=7300001
# Arq job timeout for the payroll job (seconds)
PAYROLL_JOB_TIMEOUT=300
# Attendance: minutes of a standard day (above it counts as OT)
STANDARD_DAILY_MINUTES=480
# Attendance: unpaid break deducted when worked time exceeds the threshold
UNPAID_BREAK_AFTER_MINUTES=360
UNPAID_BREAK_MINUTES=60
# Events before this local hour belong to the previous day when that day's shift crosses midnight
NIGHT_SHIFT_CUTOFF_HOUR=12

# Optional: scenario for the locust service (profile "loadtest")
SCENARIO=steady

# --- Backup / restore (see scripts/backup/) ---
# Host directory holding dump/, base/, wal/ and pre-restore/ (git-ignored)
BACKUP_DIR=./backups
# Logical dump (pg_dump -Fc) every N minutes
BACKUP_INTERVAL_MINUTES=30
# Base backup (start point for point-in-time recovery) every N hours
BASEBACKUP_INTERVAL_HOURS=24
# How many dumps / base backups to keep (older ones, and WAL older than the oldest base, are pruned)
BACKUP_KEEP_DUMPS=48
BACKUP_KEEP_BASE=3
# Force a WAL segment switch at least every N seconds: upper bound of data lost with PITR
WAL_ARCHIVE_TIMEOUT=300

# --- Ports ---
# Host port (bound to 127.0.0.1) for the api container
API_PORT=8000

# --- Safe writes / overload (all optional, defaults shown) ---
# Password hashing (argon2id). Defaults follow the OWASP Password Storage Cheat Sheet
# minimum (19 MiB, 2 iterations, 1 lane). Existing hashes keep working when these change.
ARGON2_TIME_COST=2
ARGON2_MEMORY_KIB=19456
ARGON2_PARALLELISM=1
# Simultaneous password hashes per api process (each uses ARGON2_MEMORY_KIB of RAM)
HASH_CONCURRENCY=2
# Logins queued for a hash per process; above this the api answers 503
LOGIN_MAX_WAITING=200
# Retry-After header (seconds) on every 503
RETRY_AFTER_SECONDS=2
# Postgres per-connection limits: fail fast instead of piling requests up
DB_STATEMENT_TIMEOUT_MS=5000
DB_LOCK_TIMEOUT_MS=2000
DB_IDLE_IN_TX_TIMEOUT_MS=10000
# Connection pools. Budget: UVICORN_WORKERS*(DB_POOL_SIZE+DB_MAX_OVERFLOW) + WORKER_DB_POOL_SIZE*ARQ_MAX_JOBS
# + DB_RESERVED_CONNECTIONS must stay under Postgres max_connections (the api logs a WARNING otherwise)
UVICORN_WORKERS=3
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT=10
# Arq worker: own small pool, concurrent jobs
WORKER_DB_POOL_SIZE=2
ARQ_MAX_JOBS=2
DB_RESERVED_CONNECTIONS=10
# One JSON access log line per request (X-Request-ID is always returned)
ACCESS_LOG=true
# Redis rate limits per minute. Set RATE_LIMIT_ENABLED=false before load testing (a single
# test user would hit the cap). Redis down + FAIL_OPEN=true lets requests through (logged).
RATE_LIMIT_ENABLED=true
RATE_LIMIT_FAIL_OPEN=true
RATE_LOGIN_PER_MIN=20
RATE_WRITE_PER_MIN=600
# In-process cache of the auth lookup; a user who left can keep a valid token up to this many
# seconds on a process that cached them. 0 disables it.
AUTH_CACHE_TTL_SECONDS=30
AUTH_CACHE_MAX=10000
