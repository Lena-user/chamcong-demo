# Copy to .env and adjust. Never commit .env.

# --- PostgreSQL (container "db") ---
POSTGRES_USER=chamcong
POSTGRES_PASSWORD=change-me-db
POSTGRES_DB=chamcong

# SQLAlchemy URL used by api/worker (host "db" is the compose service name)
DATABASE_URL=postgresql+asyncpg://chamcong:change-me-db@db:5432/chamcong
# Database used by pytest (created by scripts/init-db.sql)
TEST_DATABASE_URL=postgresql+asyncpg://chamcong:change-me-db@db:5432/chamcong_test

# --- Redis (job queue + health check) ---
REDIS_URL=redis://redis:6379/0

# --- Auth ---
# HS256 signing key for JWT; use a long random string
JWT_SECRET=change-me-to-a-long-random-string
# Shared password for every seeded account (demo data only)
SEED_PASSWORD=change-me-demo

# --- HTTP ---
# Comma-separated Host headers accepted by TrustedHostMiddleware
ALLOWED_HOSTS=localhost,127.0.0.1,api,*.trycloudflare.com

# Optional: scenario for the locust service (profile "loadtest")
SCENARIO=steady
